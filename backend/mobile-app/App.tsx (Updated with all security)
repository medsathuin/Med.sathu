import React, { useEffect, useState } from 'react';
import { SafeAreaView, StatusBar, Text, View, ActivityIndicator, Alert } from 'react-native';
import CertificatePinningService from './src/services/certificatePinning';
import RASPService from './src/services/rasp.service';
import SecureUIService from './src/services/secureUIService';
import AntiTamperingService from './src/services/antiTampering.service';
import SecureStorage from './src/services/secureStorage';

const App = () => {
  const [isLoading, setIsLoading] = useState(true);
  const [isSecure, setIsSecure] = useState(false);
  const [securityStatus, setSecurityStatus] = useState<string[]>([]);

  useEffect(() => {
    initializeSecurity();
  }, []);

  const initializeSecurity = async () => {
    try {
      setIsLoading(true);
      
      // 1. Initialize certificate pinning
      CertificatePinningService.setEnvironment('production');
      
      // 2. Start RASP monitoring
      await RASPService.startMonitoring();
      
      // 3. Perform anti-tampering check
      const integrity = await AntiTamperingService.performIntegrityCheck();
      if (!integrity.passed) {
        Alert.alert(
          'Security Alert',
          'App integrity check failed. Please reinstall the app.',
          [{ text: 'OK', onPress: () => {} }]
        );
        setSecurityStatus(['Integrity check failed']);
        setIsSecure(false);
      } else {
        setIsSecure(true);
        setSecurityStatus(['✅ All security checks passed']);
      }
      
      // 4. Start periodic integrity checks
      AntiTamperingService.startPeriodicChecks(120000); // Every 2 minutes
      
      // 5. Check for RASP alerts
      const alerts = RASPService.getAlerts();
      if (alerts.some(a => a.type === 'critical')) {
        setSecurityStatus(['⚠️ Security alerts detected']);
      }
      
    } catch (error) {
      console.error('Security initialization error:', error);
      setSecurityStatus(['❌ Security initialization failed']);
    } finally {
      setIsLoading(false);
    }
  };

  if (isLoading) {
    return (
      <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center', backgroundColor: '#f0f4f8' }}>
        <ActivityIndicator size="large" color="#1e3a8a" />
        <Text style={{ marginTop: 20, fontSize: 16, color: '#1e3a8a' }}>
          Securing your connection...
        </Text>
        <Text style={{ marginTop: 10, fontSize: 12, color: 'gray' }}>
          🔒 Certificate Pinning • RASP • Anti-Tampering
        </Text>
      </View>
    );
  }

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: '#f0f4f8' }}>
      <StatusBar barStyle="light-content" backgroundColor="#1e3a8a" />
      
      <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center', padding: 20 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1e3a8a' }}>🏥 Medsathu.inn</Text>
        <Text style={{ fontSize: 16, color: isSecure ? '#16a34a' : '#dc2626', marginTop: 8 }}>
          {isSecure ? '✅ App is Secure' : '⚠️ Security Warning'}
        </Text>
        
        <View style={{ marginTop: 30, width: '100%', maxWidth: 400 }}>
          {securityStatus.map((status, index) => (
            <View key={index} style={{ 
              backgroundColor: 'white', 
              padding: 16, 
              borderRadius: 12, 
              marginBottom: 10,
              shadowColor: '#000',
              shadowOffset: { width: 0, height: 2 },
              shadowOpacity: 0.1,
              shadowRadius: 4,
              elevation: 3,
            }}>
              <Text style={{ fontSize: 14, color: '#1f2937' }}>{status}</Text>
            </View>
          ))}
          
          <View style={{ backgroundColor: 'white', padding: 16, borderRadius: 12, marginBottom: 10 }}>
            <Text style={{ fontSize: 14, fontWeight: '600', color: '#1e3a8a' }}>🔒 Certificate Pinning</Text>
            <Text style={{ fontSize: 12, color: 'gray' }}>MITM attack protection enabled</Text>
          </View>
          
          <View style={{ backgroundColor: 'white', padding: 16, borderRadius: 12, marginBottom: 10 }}>
            <Text style={{ fontSize: 14, fontWeight: '600', color: '#1e3a8a' }}>🛡️ RASP Protection</Text>
            <Text style={{ fontSize: 12, color: 'gray' }}>Runtime application self-protection active</Text>
          </View>
          
          <View style={{ backgroundColor: 'white', padding: 16, borderRadius: 12, marginBottom: 10 }}>
            <Text style={{ fontSize: 14, fontWeight: '600', color: '#1e3a8a' }}>🔐 Anti-Tampering</Text>
            <Text style={{ fontSize: 12, color: 'gray' }}>Integrity checks running every 2 minutes</Text>
          </View>
          
          <View style={{ backgroundColor: 'white', padding: 16, borderRadius: 12 }}>
            <Text style={{ fontSize: 14, fontWeight: '600', color: '#1e3a8a' }}>📱 Screen Protection</Text>
            <Text style={{ fontSize: 12, color: 'gray' }}>Screenshots & recording detection active</Text>
          </View>
        </View>
      </View>
    </SafeAreaView>
  );
};

export default App;