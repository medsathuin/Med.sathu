import React, { useEffect } from 'react';
import { SafeAreaView, StatusBar, Text, View, ActivityIndicator } from 'react-native';
import { SecurityProvider, useSecurity } from './src/context/SecurityContext';
import SecureStorage from './src/services/secureStorage';

const AppContent = () => {
  const { isLoading, isAuthenticated, isDeviceSecure, securityIssues } = useSecurity();

  if (isLoading) {
    return (
      <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
        <ActivityIndicator size="large" color="#1e3a8a" />
        <Text style={{ marginTop: 20, fontSize: 16, color: '#1e3a8a' }}>
          Securing your connection...
        </Text>
      </View>
    );
  }

  if (!isDeviceSecure) {
    return (
      <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center', padding: 20 }}>
        <Text style={{ fontSize: 24, color: 'red', marginBottom: 10 }}>⚠️</Text>
        <Text style={{ fontSize: 18, fontWeight: 'bold', textAlign: 'center' }}>
          Device Security Warning
        </Text>
        <Text style={{ fontSize: 14, color: 'gray', textAlign: 'center', marginTop: 10 }}>
          Your device has security issues:
        </Text>
        {securityIssues.map((issue, index) => (
          <Text key={index} style={{ fontSize: 14, color: 'red', textAlign: 'center', marginTop: 5 }}>
            • {issue}
          </Text>
        ))}
        <Text style={{ fontSize: 14, color: 'gray', textAlign: 'center', marginTop: 20 }}>
          Please secure your device to access Medsathu.inn
        </Text>
      </View>
    );
  }

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: '#f0f4f8' }}>
      <StatusBar barStyle="light-content" backgroundColor="#1e3a8a" />
      
      {/* Main App Navigation */}
      <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center', padding: 20 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1e3a8a' }}>🏥 Medsathu.inn</Text>
        <Text style={{ fontSize: 16, color: 'gray', marginTop: 8 }}>
          {isAuthenticated ? '✅ Secured & Authenticated' : '🔐 Please Login'}
        </Text>
        
        {/* Demo content */}
        <View style={{ marginTop: 30, width: '100%' }}>
          <View style={{ backgroundColor: 'white', padding: 16, borderRadius: 12, marginBottom: 10 }}>
            <Text style={{ fontSize: 16, fontWeight: '600', color: '#1e3a8a' }}>🔒 Encrypted Storage</Text>
            <Text style={{ fontSize: 14, color: 'gray' }}>All data stored securely</Text>
          </View>
          <View style={{ backgroundColor: 'white', padding: 16, borderRadius: 12, marginBottom: 10 }}>
            <Text style={{ fontSize: 16, fontWeight: '600', color: '#1e3a8a' }}>📱 Biometric Ready</Text>
            <Text style={{ fontSize: 14, color: 'gray' }}>Face ID / Fingerprint enabled</Text>
          </View>
          <View style={{ backgroundColor: 'white', padding: 16, borderRadius: 12 }}>
            <Text style={{ fontSize: 16, fontWeight: '600', color: '#1e3a8a' }}>🛡️ Device Integrity</Text>
            <Text style={{ fontSize: 14, color: 'gray' }}>Verified secure device</Text>
          </View>
        </View>
      </View>
    </SafeAreaView>
  );
};

const App = () => {
  return (
    <SecurityProvider>
      <AppContent />
    </SecurityProvider>
  );
};

export default App;