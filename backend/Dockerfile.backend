# ========== BACKEND DOCKERFILE ==========
FROM node:18-alpine

# Create app directory
WORKDIR /app

# Install dependencies
COPY backend/package*.json ./
RUN npm ci --only=production

# Copy source code
COPY backend/src ./src

# Copy config files
COPY backend/.env.production ./.env

# Expose port
EXPOSE 5000

# Start the app
CMD ["npm", "start"]